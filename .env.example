# Copy this file to .env and populate your secrets.
# .env is gitignored — never commit real credentials.
# All variables here are loaded and exported by bin/setup_environment.sh.

# macOS / Docker Desktop — no NVIDIA GPU passthrough on Mac
USE_NVIDIA=false

# Moodle Docker network (matches the Compose project default network name)
MOODLE_NETWORK=moodle-docker_default

# Behat settings
MOODLE_DOCKER_BROWSER=chrome

# Moodle web settings
MOODLE_DOCKER_WEB_HOST=localhost
MOODLE_DOCKER_WEB_PORT=8000
MOODLE_DOCKER_SSL=false

# Expose PostgreSQL to localhost so local AI tools can query the Moodle database.
# Remove or comment out this line to keep the DB internal to Docker only.
# Connection from Mac: host=localhost port=5432 dbname=moodle user=moodle password=m@0dl3ing
MOODLE_DOCKER_DB_PORT=127.0.0.1:5432

# AI/LLM service URLs
# If running Ollama natively on macOS (recommended for Apple Silicon),
# containers reach it via host.docker.internal:
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI API keys — replace with real values in your local .env
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
HUGGINGFACE_API_KEY=your-huggingface-key-here
